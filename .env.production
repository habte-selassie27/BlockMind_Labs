# Vercel Environment Variables
# Set these in Vercel Dashboard → Settings → Environment Variables

# Together.ai (LLM)
TOGETHER_API_KEY=your_together_api_key_here

# Database
DATABASE_URL=postgresql://user:pass@host:5432/blockmind

# Redis
REDIS_URL=redis://default:pass@host:6379

# JWT
JWT_SECRET=your_jwt_secret_here

# GIWA
GIWA_RPC_URL=https://rpc.giwa.io
GIWA_CHAIN_ID=9134

# Wallet Signer
WALLET_SIGNER_URL=https://wallet-signer.blockmind.ai

# MongoDB
MONGO_URL=mongodb://user:pass@host:27017/blockmind
