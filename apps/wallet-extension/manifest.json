{
  "manifest_version": 3,
  "name": "Blockmind Wallet",
  "version": "1.0.0",
  "description": "GIWA-native, non-custodial wallet with built-in simulation, Scam Shield, and approval safeguards.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blockmind Wallet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://sepolia-rpc.giwa.io/*",
    "https://rpc.giwa.io/*",
    "https://api.blockmind.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.giwa.io/*",
        "https://*.blockmind.ai/*",
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.giwa.io/*",
        "https://*.blockmind.ai/*",
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
