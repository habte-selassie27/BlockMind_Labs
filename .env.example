# Blockmind Labs — Environment Variables
# Copy to .env and fill in values

# ── Auth ───────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here

# ── LLM APIs ───────────────────────────────────────────────────
OPENAI_API_KEY=
TOGETHER_API_KEY=

# ── GIWA Chain ─────────────────────────────────────────────────
GIWA_RPC_URL=https://sepolia-rpc.giwa.io
GIWA_WS_URL=wss://sepolia-ws.giwa.io
GIWA_CHAIN_ID=91342

# ── Wallet Signer ──────────────────────────────────────────────
SIGNER_KEY_PASSWORD=

# ── External Services ──────────────────────────────────────────
SENDGRID_API_KEY=
TWILIO_API_KEY=

# ── Monitoring ─────────────────────────────────────────────────
GRAFANA_API_KEY=
PROMETHEUS_URL=http://localhost:9090
